/*
 * -------------------------------------------------
 *  SeroTyper@KAUST v0.3: Identifying Viral Serotypes and coinfections
 * -------------------------------------------------
 *
 * Notes:
 *   - This workflow intentionally tolerates expected per-sample failures
 *     because low-depth clinical samples may fail at multiple steps.
 *   - Coinfection branches are also expected to fail for many non-coinfected
 *     samples. Process-level ignore is therefore retained by design.
 *   - Workflow-level misconfiguration is handled in main.nf via validation.
 */

// ----------------------------------------------------------------------------
// Default parameters
// ----------------------------------------------------------------------------
params {

  // --------------------------------------------------------------------------
  // Core I/O parameters
  // --------------------------------------------------------------------------
  help       = false
  input      = "/data/ksa_dengue/data/2021/*.fastq.gz"
  outdir     = "/data/ksa_dengue/serotyper/results"
  mode       = "SE"

  // --------------------------------------------------------------------------
  // Runtime / scheduling controls
  // --------------------------------------------------------------------------
  cpus       = 20
  jobs       = 2

  // --------------------------------------------------------------------------
  // Sample / analysis parameters
  // --------------------------------------------------------------------------
  genomesize = 10000
  assembler  = "canu"
  cov        = "20"

  // --------------------------------------------------------------------------
  // Databases / references
  // --------------------------------------------------------------------------
  mafftMeta    = "/data/ksa_dengue/db/denv_0.8/05_Finalcombinedmeta.tsv"

  /*
   * VirStrain database path/prefix.
   * This parameter is used in main.nf by VIRSTRAIN_CALL.
   */
  db           = "/data/ksa_dengue/db/denv_0.8"

  /*
   * BLAST database prefix.
   * Required if skipBlast = false.
   */
  blastdb      = "/data/ksa_dengue/db/denv_0.8/denv_blastn_db"

  /*
   * Directory containing reference FASTA files used by:
   *   - reference-based assembly
   *   - coinfection module
   *
   * Keep empty by default and provide explicitly per run/profile as needed.
   */
  referenceDir = "/data/ksa_dengue/db/denv_refs"

  /*
   * Model/resources for ONT reference-based assembly branch.
   * Prefer overriding in profile or CLI for environment portability.
   */
  clair3model  = "/data/ksa_dengue/serotyper/resources/r1041_e82_400bps_sup_v430/"
  primerfile   = "/data/ksa_dengue/serotyper/resources/DENV_multiplex_primer_sets_v1.xlsx"

  /*
   * Optional ONT sequencing summary file for pycoQC.
   */
  summaryFile  = ""

  // --------------------------------------------------------------------------
  // Additional tool arguments
  // --------------------------------------------------------------------------
  aligntrim_ext = '-m 10 --verbose'

  fastp_ext     = "--detect_adapter_for_pe --qualified_quality_phred 30 --length_required 75 --correction --adapter_fasta ${projectDir}/resources/adapters/TruSeq3-PE.fa"
  fastqc_ext    = '--quiet'
  hostile_ext   = '--index human-t2t-hla.rs-viral-202401_ml-phage-202401'
  spades_ext    = ''
  minimap_ext   = 'map-ont'
  flye_ext      = '--nano-hq'
  scrubb_ext    = '-x ava-ont -g 500'
  yacrd_ext     = '-c 4 -n 0.4'
  canu_ext      = '-nanopore'
  clair3_ext    = '--platform="ont" --haploid_precise --include_all_ctgs --no_phasing_for_fa --enable_long_indel --enable_variant_calling_at_sequence_head_and_tail --var_pct_full=1 --ref_pct_full=1'

  /*
   * Kept for help/backward compatibility.
   * Currently not used in main.nf orchestration.
   */
  skipAlignment = false

  // --------------------------------------------------------------------------
  // Logical / skip parameters
  // --------------------------------------------------------------------------
  skipTrim              = false
  skipDehost            = false
  skipDenovoAssembly    = true
  skipReferenceAssembly = false
  skipBlast             = true
  skipScrubbing         = false
  skipPrimertrim        = false
  skipCoinfection       = false

  // --------------------------------------------------------------------------
  // Coinfection-specific settings
  // --------------------------------------------------------------------------
  coverageCoinfection = 20
  meandepth           = 5
  min_reads_coinf     = 200
}


// ----------------------------------------------------------------------------
// Profiles
// ----------------------------------------------------------------------------
profiles {

  conda {
    params.enable_conda = true
    conda.enabled       = true
    conda.useMamba      = true
  }
}


// ----------------------------------------------------------------------------
// Workflow reporting
// ----------------------------------------------------------------------------
workflow {
  /*
   * Because process failures are intentionally ignored for expected sample-level
   * dropout, do not fail the overall workflow due to ignored tasks alone.
   */
  failOnIgnore = false
}

timeline {
  enabled   = true
  file      = "${params.outdir}/timeline.html"
  overwrite = true
}

report {
  enabled   = true
  file      = "${params.outdir}/report.html"
  overwrite = true
}

trace {
  enabled   = true
  file      = "${params.outdir}/execution_trace.txt"
  overwrite = true
}

dag {
  enabled   = true
  file      = "${params.outdir}/pipeline_dag.html"
  overwrite = true
}


// ----------------------------------------------------------------------------
// Process defaults
// ----------------------------------------------------------------------------
process {

  /*
   * Safer shell handling:
   *   -e : exit on error
   *   -u : undefined variables are errors
   *   -o pipefail : fail pipelines if any command fails
   */
  shell = ['/bin/bash', '-euo', 'pipefail']

  /*
   * Intentional design choice:
   * Expected in low-depth clinical samples and in coinfection branches.
   * Validation in main.nf protects against workflow-level misconfiguration.
   */
  errorStrategy = 'ignore'

  /*
   * Conservative defaults. Individual modules can override with labels or
   * withName blocks if needed.
   */
  cpus   = params.cpus
  memory = '20 GB'
}
